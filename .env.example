# Salin ke Vercel Dashboard > Project > Settings > Environment Variables.
# JANGAN commit file .env berisi nilai asli.

# --- Firebase Admin (service account; dari Firebase Console > Project settings > Service accounts)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Tempel private_key apa adanya (dengan \n literal) dalam satu baris
FIREBASE_PRIVATE_KEY=

# --- Firebase Web (publik; untuk login di halaman web). Dari Project settings > Your apps > Web app
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=

# --- Midtrans (Sandbox dan Production memakai key BERBEDA; jangan dicampur)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# --- URL
# URL publik deployment ini tanpa slash akhir, mis. https://agnipos-subscription.vercel.app
SUBSCRIPTION_BASE_URL=

# --- Promo
# String acak panjang (>=32 karakter) untuk HMAC pencarian kode. Contoh: openssl rand -base64 48
PROMO_HMAC_SECRET=
# 64 karakter hex untuk enkripsi kode (AES-256-GCM). Contoh: openssl rand -hex 32
PROMO_ENC_KEY=

# --- Admin aplikasi (UID Firebase Auth, dipisah koma) yang boleh membuat/mengekspor kampanye promo
ADMIN_UIDS=
